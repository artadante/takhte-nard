# PostgreSQL Connection (Local via pgAdmin 4 or remote server)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_postgres_password_here
PG_DATABASE=postgres

# Backend API Server Port
PORT=3001
VITE_API_URL=http://localhost:3001
